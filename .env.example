# انسخ الملف ده باسم جديد وغيّر القيم اللي فيه
# cp .env.example .env
APP_NAME="DocuMind API"
APP_VERSION=0.2.2
# development | staging | production
ENVIRONMENT=development
DEBUG=false
# أقصى حجم للملف المرفوع بالبايت، وده 2 ميجا
MAX_UPLOAD_BYTES=2097152
# أقصى عدد أسئلة لكل شركة في اليوم
DAILY_QUESTION_QUOTA=20

# الشركات، وكل شركة بالمفتاح بتاعها
# اعمل مفتاح حقيقي بالأمر ده
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
ORGS='[{"id": "org-acme", "name": "Acme", "api_key": "dev-acme-change-me"}, {"id": "org-globex", "name": "Globex", "api_key": "dev-globex-change-me"}]'
